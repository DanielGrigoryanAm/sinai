# Production settings. setup.sh copies this to deploy/.env on the server
# and fills in the secrets; the rest you fill in.

# Where the API answers. Until a domain is bought, use the server IP with
# dashes on sslip.io, e.g. 203-0-113-7.sslip.io (real HTTPS, no setup).
API_DOMAIN=

# Generated by setup.sh.
POSTGRES_PASSWORD=
JWT_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Cloudflare R2: dashboard → R2 → bucket "sinai" → Manage API tokens,
# Object Read & Write on that bucket. Endpoint: <account id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=sinai
S3_USE_SSL=true
S3_REGION=auto
S3_CREATE_BUCKET=false

# Set to any value once deploy/secrets/fcm.json (the Firebase service
# account key) is on the server, to turn pushes on.
FCM_CREDENTIALS_FILE=
