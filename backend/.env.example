# Copy to .env and adjust. Values here match docker-compose.yml.
HTTP_ADDR=:8080
DATABASE_URL=postgres://sinai:sinai@localhost:5432/sinai?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Any long random string; signs access tokens.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# S3-compatible storage for media. PUBLIC_ENDPOINT is how phones reach it
# (e.g. your Mac's LAN address); empty means the same as ENDPOINT.
S3_ENDPOINT=localhost:8333
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=sinai
S3_SECRET_KEY=sinai-secret
S3_BUCKET=sinai
S3_USE_SSL=false

# Firebase service account key (Project settings → Service accounts →
# Generate new private key). Empty: pushes are off.
FCM_CREDENTIALS_FILE=
